# Normalise to LF in the repository. Checkouts still get the platform's
# native endings; this only stops the same file looking modified on a
# different machine.
* text=auto eol=lf
*.png binary
*.jpg binary

# Frozen evidence hashes cover exact bytes, including native line endings.
research/results/no-budget-local-model.json -text
research/results/no-budget-replication.json -text
research/results/no-budget-replication/** -text

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Stores. The fabric writes SQLite files wherever it is pointed; the demo and
# the tests create them freely. Results worth keeping live in research/results/
# as text, not as databases.
*.db
*.db-wal
*.db-shm

# Scratch
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp-tests/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Third-party benchmark data, fetched on demand by experiments/external_bench.py.
# Not committed: it is 8 MB of someone else's dataset under its own licence, and
# the harness re-downloads it. A commit of it was reverted rather than kept.
research/bench/external/scifact-raw/

# relevance_v2 is generated, not committed: 12.4 MB a split. MANIFEST.json
# carries the SHA-256 of both and tests/test_relevance_v2.py rebuilds and
# compares, which asserts the generator still produces those bytes -- a
# stronger claim than committing them.
research/bench/relevance_v2/dev.json
research/bench/relevance_v2/test.json
research/bench/propagation_v1/dev.json
research/bench/propagation_v1/test.json

research/bench/facet_v1/dev.json
research/bench/facet_v1/test.json

# LongMemEval: downloaded, never committed. 15 MB for the oracle split alone,
# and the same reasoning as the external SciFact corpus.
research/bench/longmemeval/data/
research/bench/relevance_v2/holdout_p1b.json
research/bench/relevance_v2/holdout_p1c.json
research/bench/relevance_v2/holdout_p1d.json
research/bench/relevance_v2/holdout_p2b.json
.d1-cache.json
.a1-cache.json
